# Comma-separated hostname(s) of the Betriebszentrale (app) domain, e.g. biz.app.msce.info
# Tells nextjs_app/proxy.ts to route these hosts to the app instead of a tenant's public website.
APP_HOST=biz.app.msce.info
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=business-os
MINIO_SECURE=false
# Fernet-Schlüssel (44 Zeichen base64) zum Verschlüsseln der Postfach-Zugangsdaten (PROJ-4).
# Erzeugen mit: python -c "import cryptography.fernet, os; print(cryptography.fernet.Fernet.generate_key().decode())"
EMAIL_CREDENTIALS_KEY=
